{
  "name": "debugcopilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local debugging copilot: scenario-driven diagnosis with evidence from logs and source.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"verify/unit/*.test.mjs\"",
    "cli": "node src/app/cli.mjs",
    "desktop": "electron src/app/electron/main.mjs",
    "desktop:smoke": "electron src/app/electron/main.mjs --smoke --port 0",
    "manual:e2e": "node verify/manual/e2e-harness.mjs",
    "dist:dir": "node node_modules/electron-builder/cli.js --win --dir",
    "dist:win": "node node_modules/electron-builder/cli.js --win --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "iconv-lite": "^0.7.3",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "author": "PotterYi",
  "build": {
    "appId": "com.debugcopilot.app",
    "productName": "DebugCopilot",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**"
    ],
    "files": [
      "src/**/*",
      "configs/default.json",
      "scenarios/**/*",
      "package.json",
      "!verify/**",
      "!docs/**",
      "!.tmp/**",
      "!runs/**",
      "!dist/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "main": "src/app/electron/main.mjs"
}
